APP_NAME=MentorConnect
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mentorconnect-web.onrender.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR_RENDER_DB_HOST
DB_PORT=5432
DB_DATABASE=YOUR_RENDER_DB_NAME
DB_USERNAME=YOUR_RENDER_DB_USER
DB_PASSWORD=YOUR_RENDER_DB_PASSWORD
DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

ADMIN_NAME="Administrateur"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_WITH_A_LONG_PASSWORD

# Free strict mode: no second Reverb service.
# The chat falls back to polling every few seconds.
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
